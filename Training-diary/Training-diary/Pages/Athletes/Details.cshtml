@page "{id:int}"
@model Training_diary.Pages.Athletes.DetailsModel
@{
    ViewData["Title"] = "Детали атлета";
}

<h1>Информация об атлете</h1>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Имя:</strong> @Model.Athlete.Name</p>
        <p><strong>Email:</strong> @Model.Athlete.Email</p>
        <p><strong>Телефон:</strong> @Model.Athlete.Phone</p>
        <p><strong>Дата рождения:</strong> @Model.Athlete.BirthDate.ToShortDateString()</p>
    </div>
</div>

<p>
    <a asp-page="Index" class="btn btn-secondary">Назад к списку</a>
</p>