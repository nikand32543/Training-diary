@page
@model Training_diary.Pages.Athletes.CreateModel
@{
    ViewData["Title"] = "Добавить атлета";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Добавить атлета</h4>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Athlete.Name" class="form-label">Имя атлета</label>
                            <input asp-for="Athlete.Name" class="form-control" />
                            <span asp-validation-for="Athlete.Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Athlete.Email" class="form-label">Email</label>
                            <input asp-for="Athlete.Email" type="email" class="form-control" />
                            <span asp-validation-for="Athlete.Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Athlete.Phone" class="form-label">Телефон</label>
                            <input asp-for="Athlete.Phone" class="form-control" />
                            <span asp-validation-for="Athlete.Phone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Athlete.BirthDate" class="form-label">Дата рождения</label>
                            <input asp-for="Athlete.BirthDate" type="date" class="form-control" />
                            <span asp-validation-for="Athlete.BirthDate" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-page="Index" class="btn btn-secondary">Назад</a>
                            <button type="submit" class="btn btn-success">Сохранить</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}