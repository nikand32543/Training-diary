@page "{id:int}"
@model Training_diary.Pages.Athletes.DeleteModel
@{
    ViewData["Title"] = "Удалить атлета";
}

<h1>Удалить атлета</h1>

<h3>Вы уверены, что хотите удалить этого атлета?</h3>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Имя:</strong> @Model.Athlete.Name</p>
        <p><strong>Email:</strong> @Model.Athlete.Email</p>
        <p><strong>Телефон:</strong> @Model.Athlete.Phone</p>
        <p><strong>Дата рождения:</strong> @Model.Athlete.BirthDate.ToShortDateString()</p>
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Athlete.Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-page="Index" class="btn btn-secondary">Отмена</a>
</form>