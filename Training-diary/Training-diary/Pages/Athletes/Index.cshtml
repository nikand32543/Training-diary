@page
@model Training_diary.Pages.Athletes.IndexModel
@{
	ViewData["Title"] = "Список атлетов";
}
<h1>Список атлетов</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить атлета</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Имя</th>
            <th>Email</th>
            <th>Телефон</th>
            <th>Дата рождения</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var athlete in Model.Athletes)
        {
            <tr>
                <td>@athlete.Name</td>
                <td>@athlete.Email</td>
                <td>@athlete.Phone</td>
                <td>@athlete.BirthDate.ToShortDateString()</td>
                <td>
                    <a asp-page="Details" asp-route-id="@athlete.Id" class="btn btn-sm btn-info">Детали</a>
                    <a asp-page="Edit" asp-route-id="@athlete.Id" class="btn btn-sm btn-warning">Изменить</a>
                    <a asp-page="Delete" asp-route-id="@athlete.Id" class="btn btn-sm btn-danger">Удалить</a>
                 </td>
             </tr>
        }
    </tbody>
</table>