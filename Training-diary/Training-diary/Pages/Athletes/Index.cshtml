@page
@model Training_diary.Pages.Athletes.IndexModel
@{
    ViewData["Title"] = "Список атлетов";
}

<div class="container mt-4">
    <div class="row justify-content-between align-items-center mb-4">
        <div class="col">
            <h1 class="h3 mb-0">Список атлетов</h1>
        </div>
        <div class="col-auto">
            <a asp-page="Create" class="btn btn-primary">Добавить атлета</a>
        </div>
    </div>

    <div class="row">
        @foreach (var athlete in Model.Athletes)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@athlete.Name</h5>

                        <p class="card-text mb-1">
                            <strong>Email:</strong> @(string.IsNullOrEmpty(athlete.Email) ? "—" : athlete.Email)
                        </p>
                        <p class="card-text mb-1">
                            <strong>Телефон:</strong> @(string.IsNullOrEmpty(athlete.Phone) ? "—" : athlete.Phone)
                        </p>
                        <p class="card-text">
                            <strong>Дата рождения:</strong> @athlete.BirthDate.ToShortDateString()
                        </p>

                        <hr />
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-muted">ID: @athlete.Id</small>
                            <div class="btn-group btn-group-sm">
                                <a asp-page="Details" asp-route-id="@athlete.Id" class="btn btn-outline-primary">Открыть</a>
                                <a asp-page="Edit" asp-route-id="@athlete.Id" class="btn btn-outline-secondary">Изменить</a>
                                <a asp-page="Delete" asp-route-id="@athlete.Id" class="btn btn-outline-danger">Удалить</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Athletes.Any())
    {
        <div class="alert alert-info text-center">
            Список атлетов пуст. Добавьте первого атлета!
        </div>
    }
</div>