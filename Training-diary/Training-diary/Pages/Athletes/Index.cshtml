@page
@model Training_diary.Pages.Athletes.IndexModel
@{
    ViewData["Title"] = "Список атлетов";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="display-6"><i class="bi bi-people"></i> Атлеты</h2>
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            Добавить атлета
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var athlete in Model.Athletes)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 transition-hover">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                 style="width: 45px; height: 45px; font-weight: bold;">
                                @athlete.Name?[0].ToString().ToUpper()
                            </div>
                            <div class="ms-3">
                                <h5 class="card-title mb-0">@athlete.Name</h5>
                                <small class="text-muted text-uppercase" style="font-size: 0.7rem;">ID: @athlete.Id</small>
                            </div>
                        </div>

                        <div class="mb-2">
                            <small class="text-muted d-block">Email</small>
                            <span>@athlete.Email</span>
                        </div>
                        <div class="mb-2">
                            <small class="text-muted d-block">Телефон</small>
                            <span>@athlete.Phone</span>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top border-secondary d-flex justify-content-between">
                        <a asp-page="Details" asp-route-id="@athlete.Id" class="btn btn-sm btn-link text-decoration-none">Подробнее</a>
                        <div class="btn-group">
                            <a asp-page="Edit" asp-route-id="@athlete.Id" class="btn btn-sm btn-outline-warning border-0">Изменить</a>
                            <a asp-page="Delete" asp-route-id="@athlete.Id" class="btn btn-sm btn-outline-danger border-0">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>