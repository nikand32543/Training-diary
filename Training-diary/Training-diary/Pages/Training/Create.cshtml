@page
@model Training_diary.Pages.Training.CreateModel
@{
    ViewData["Title"] = "Добавить тренировку";
}

<h1>Добавить тренировку</h1>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Дата тренировки</label>
        <input asp-for="Training.Date" type="datetime-local" class="form-control" />
        <span asp-validation-for="Training.Date" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Тип упражнения</label>
        <input asp-for="Training.ExerciseType" class="form-control" />
        <span asp-validation-for="Training.ExerciseType" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Длительность (минуты)</label>
        <input asp-for="Training.DurationMinutes" class="form-control" type="number" />
        <span asp-validation-for="Training.DurationMinutes" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Сожжено калорий</label>
        <input asp-for="Training.CaloriesBurned" class="form-control" type="number" />
        <span asp-validation-for="Training.CaloriesBurned" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Заметки</label>
        <textarea asp-for="Training.Notes" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Training.Notes" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Training.Athlete.Name" class="form-label">Атлет</label>
        <select asp-for="Training.Athlete.Id" class="form-select" asp-items="Model.AthletesList">
            <option value="">Выберите атлета</option>
        </select>
        <span asp-validation-for="Training.Athlete" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-page="Index" class="btn btn-secondary">Назад к списку</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}