@page
@model Training_diary.Pages.Training.IndexModel
@{
    ViewData["Title"] = "Список тренировок";
}

<h1>Список тренировок</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Добавить новую тренировку</a>
</p>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Дата</th>
            <th>Тип упражнения</th>
            <th>Длительность (мин)</th>
            <th>Калории</th>
            <th>Заметки</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var training in Model.Trainings)
        {
            <tr>
                <td>@training.Date.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@training.ExerciseType</td>
                <td>@training.DurationMinutes</td>
                <td>@training.CaloriesBurned</td>
                <td>@(training.Notes.Length > 50 ? training.Notes.Substring(0, 50) + "..." : training.Notes)</td>
                <td>
                    <a asp-page="Details" asp-route-id="@training.Id" class="btn btn-sm btn-info">Открыть</a>
                    <a asp-page="Edit" asp-route-id="@training.Id" class="btn btn-sm btn-warning">Изменить</a>
                    <a asp-page="Delete" asp-route-id="@training.Id" class="btn btn-sm btn-danger">Удалить</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Trainings.Any())
{
    <div class="alert alert-info">
        Нет добавленных тренировок. <a asp-page="Create">Добавьте первую тренировку</a>
    </div>
}