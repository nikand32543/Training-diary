@page
@model Training_diary.Pages.Training.IndexModel
@{
    ViewData["Title"] = "Журнал тренировок";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="display-6">Мои тренировки</h2>
        <a asp-page="Create" class="btn btn-success shadow-sm">
            Записать тренировку
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var training in Model.Trainings)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-start border-primary border-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h5 class="card-title text-primary mb-1">@training.ExerciseType</h5>
                                <p class="text-muted small mb-0">
                                    <i class="bi bi-calendar-event"></i> @training.Date.ToString("dd MMMM yyyy, HH:mm")
                                </p>
                            </div>
                            <span class="badge bg-info text-dark">@training.DurationMinutes мин</span>
                        </div>

                        <div class="row mt-3 text-center bg-light rounded py-2 g-0">
                            <div class="col-4 border-end">
                                <small class="text-muted d-block small">Калории</small>
                                <strong class="text-danger">@training.CaloriesBurned</strong>
                            </div>
                            <div class="col-8">
                                <small class="text-muted d-block small">Атлет</small>
                                <strong>@(training.Athlete?.Name ?? "Не назначен")</strong>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(training.Notes))
                        {
                            <div class="mt-3 p-2 bg-light rounded small italic shadow-none border-0">
                                <i class="bi bi-sticky text-warning"></i> @training.Notes
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white d-flex justify-content-end gap-2 border-0">
                        <a asp-page="Details" asp-route-id="@training.Id" class="btn btn-sm btn-outline-secondary">Детали</a>
                        <a asp-page="Edit" asp-route-id="@training.Id" class="btn btn-sm btn-outline-primary">Редактировать</a>
                        <a asp-page="Delete" asp-route-id="@training.Id" class="btn btn-sm btn-outline-danger">Удалить</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>