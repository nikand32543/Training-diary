@page "{id:int}"
@model Training_diary.Pages.Training.DetailsModel
@{
    ViewData["Title"] = "Информация о тренировке";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Информация о тренировке</h4>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">Дата тренировки</dt>
                        <dd class="col-sm-9">@Model.Training.Date.ToString("dd.MM.yyyy HH:mm")</dd>

                        <dt class="col-sm-3">Тип упражнения</dt>
                        <dd class="col-sm-9">@Model.Training.ExerciseType</dd>

                        <dt class="col-sm-3">Длительность</dt>
                        <dd class="col-sm-9">@Model.Training.DurationMinutes минут</dd>

                        <dt class="col-sm-3">Сожжено калорий</dt>
                        <dd class="col-sm-9">@Model.Training.CaloriesBurned ккал</dd>

                        <dt class="col-sm-3">Заметки</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Training.Notes) ? "—" : Model.Training.Notes)</dd>

                        <dt class="col-sm-3">Атлет</dt>
                        <dd class="col-sm-9">@(Model.Training.Athlete?.Name ?? "—")</dd>
                    </dl>

                    <div class="d-flex justify-content-between mt-3">
                        <a asp-page="Index" class="btn btn-secondary">Назад</a>
                        <div>
                            <a asp-page="Edit" asp-route-id="@Model.Training.Id" class="btn btn-primary">Редактировать</a>
                            <a asp-page="Delete" asp-route-id="@Model.Training.Id" class="btn btn-danger">Удалить</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>