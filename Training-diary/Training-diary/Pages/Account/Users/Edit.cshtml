@page
@model Training_diary.Pages.Account.Users.EditModel
@{
    ViewData["Title"] = "Редактирование пользователя";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm p-4">
            <h3 class="mb-4"><i class="bi bi-pencil-square me-2"></i>Редактировать пользователя</h3>

            <form method="post">
                <input type="hidden" asp-for="User.Id" />

                <div class="mb-3">
                    <label asp-for="User.Email" class="form-label">Email (Логин)</label>
                    <input asp-for="User.Email" class="form-control" placeholder="name@example.com" required />
                    <span asp-validation-for="User.Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="User.Password" class="form-label">Пароль</label>
                    <input asp-for="User.Password" type="password" class="form-control" placeholder="Введите новый или текущий пароль" required />
                    <span asp-validation-for="User.Password" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="User.Role" class="form-label">Роль в системе</label>
                    <select asp-for="User.Role" class="form-select">
                        <option value="User">User (Пользователь)</option>
                        <option value="Admin">Admin (Администратор)</option>
                    </select>
                    <span asp-validation-for="User.Role" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning text-white shadow-sm">
                        <i class="bi bi-save me-1"></i> Сохранить
                    </button>
                    <a asp-page="Index" class="btn btn-secondary shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Отмена
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>