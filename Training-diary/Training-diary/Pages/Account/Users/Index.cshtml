@page
@model Training_diary.Pages.Account.Users.IndexModel
@{
    ViewData["Title"] = "Управление пользователями";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-people-fill me-2"></i>Пользователи</h2>
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Добавить пользователя
        </a>
    </div>

    <div class="row g-4">
        @foreach (var user in Model.Users)
        {
            <div class="col-md-4 col-lg-3">
                <div class="card h-100 shadow-sm border-secondary-subtle">
                    <div class="card-body text-center d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-inline-flex align-items-center justify-content-center bg-secondary text-white rounded-circle mb-3 shadow-sm"
                                 style="width: 70px; height: 70px; font-size: 32px;">
                                <i class="bi bi-person-circle"></i>
                            </div>

                            <h5 class="card-title text-truncate" title="@user.Email">
                                @user.Email
                            </h5>

                            <p class="card-text mb-3">
                                @if (user.Role == "Admin")
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">User</span>
                                }
                            </p>
                        </div>

                        <div class="pt-3 border-top d-flex justify-content-between gap-1">
                            <a asp-page="Details" asp-route-id="@user.Id" class="btn btn-sm btn-info text-white shadow-sm flex-grow-1" title="Просмотр">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-sm btn-warning text-white shadow-sm flex-grow-1" title="Редактировать">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-sm btn-danger shadow-sm flex-grow-1" title="Удалить">
                                <i class="bi bi-trash"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>