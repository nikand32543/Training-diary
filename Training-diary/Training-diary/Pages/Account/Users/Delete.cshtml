@page
@model Training_diary.Pages.Account.Users.DeleteModel
@{
    ViewData["Title"] = "Удаление пользователя";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm p-4">
            <h3 class="text-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Удалить пользователя?
            </h3>

            <div class="alert alert-danger shadow-sm" role="alert">
                Вы уверены, что хотите навсегда удалить этого пользователя из системы?
            </div>

            <ul class="list-group mb-4 shadow-sm">
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-envelope me-2 text-muted"></i><b>Email:</b></span>
                    <span>@Model.User.Email</span>
                </li>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-shield-lock me-2 text-muted"></i><b>Роль:</b></span>
                    <span>
                        @if (Model.User.Role == "Admin")
                        {
                            <span class="badge bg-danger">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">User</span>
                        }
                    </span>
                </li>
            </ul>

            <form method="post">
                <input type="hidden" asp-for="User.Id" />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger shadow-sm">
                        <i class="bi bi-trash-fill me-1"></i> Удалить
                    </button>
                    <a asp-page="Index" class="btn btn-secondary shadow-sm">
                        <i class="bi bi-arrow-left me-1"></i> Отмена
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>